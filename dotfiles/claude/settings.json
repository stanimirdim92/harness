{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "true",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "allow": [
      "Bash(corepack enable:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(cmux browser:*)",
      "Bash(command docker logs:*)",
      "Bash(command -v cmux)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh auth status:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(test:*)",
      "Bash(wc:*)",
      "Edit(~/.claude/plans/**)",
      "mcp__context7__query-docs",
      "mcp__ide__getDiagnostics",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_episodic-memory_episodic-memory__read",
      "mcp__plugin_episodic-memory_episodic-memory__search",
      "mcp__plugin_linear_linear__get_issue",
      "mcp__plugin_linear_linear__get_team",
      "mcp__plugin_linear_linear__list_issue_labels",
      "mcp__plugin_linear_linear__list_issues",
      "mcp__plugin_linear_linear__list_projects",
      "mcp__plugin_linear_linear__list_teams",
      "mcp__plugin_Notion_notion__notion-fetch",
      "Skill(agent-browser:agent-browser)",
      "Skill(agent-browser)",
      "Skill(episodic-memory:search-conversations)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:community.cloudflare.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.renovatebot.com)",
      "WebFetch(domain:docs.virustotal.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:tailadmin.com)",
      "WebFetch(domain:www.claude.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch",
      "Bash(yarn --version)",
      "Bash(yarn info *)",
      "Bash(npx @yarnpkg/cli-dist@4.9.4 --version)",
      "Bash(COREPACK_ENABLE_STRICT=0 npx @yarnpkg/cli-dist@4.9.4 set version 4.9.4)",
      "Bash(yarn install:*)",
      "Bash(node .yarn/releases/yarn-4.9.4.cjs install)",
      "Bash(xargs -I{} echo {})",
      "Bash(php *)",
      "Bash(php artisan:*)",
      "mcp__claude_ai_Atlassian_Rovo__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssue"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)"
    ],
    "defaultMode": "auto",
    "enableAllProjectMcpServers": true
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-destructive-bash.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/warn-force-push.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/require-isolated-test-runner.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/require-worktree-for-writers.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/warn-stale-base.sh --report"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "php artisan *",
      "composer test*",
      "vendor/bin/phpunit*",
      "vendor/bin/pest*",
      "docker *",
      "mysql *",
      "redis-cli *",
      "git push*",
      "git fetch*",
      "git pull*",
      "ssh *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.composer",
        "~/.config/composer",
        "~/.npm",
        "~/.yarn",
        "~/.local/share/pnpm"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.git-credentials", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" },
        { "path": "~/.config/composer/auth.json", "mode": "deny" },
        { "path": "~/.composer/auth.json", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" },
        { "path": "~/.codex/auth.json", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "repo.packagist.org",
        "*.packagist.org"
      ]
    }
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "$HOME/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "phpstorm-plugin@phpstorm-marketplace": true,
    "episodic-memory@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "qdrant-skills@knowledge-work-plugins": true,
    "llm-application-dev@claude-code-workflows": true
  },
  "extraKnownMarketplaces": {
    "phpstorm-marketplace": {
      "source": {
        "source": "github",
        "repo": "jetbrains/phpstorm-claude-marketplace"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "claude-fable-5-1",
  "autoMemoryEnabled": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "awaySummaryEnabled": true,
  "agentPushNotifEnabled": true
}
