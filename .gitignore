# Claude Code auto-regenerates these inside the symlinked skills/ directory
# whenever a bundled/example skill (docx, pdf, pptx, xlsx, skill-creator,
# morning, session-start-hook, ...) gets listed as available in a session.
# Not deliberately-curated repo content — see README.md's "Deliberately not
# synced" list for the same category of auto-regenerated files.
/claude/skills/synced/
/claude/skills/session-start-hook/
# The Claude app moves removed skills here; they are licensed copies, not repo content.
/claude/skills/.trash/
# Fetched at a pinned commit by tools/setup/fetch-figma-skill.sh;
# the upstream repo has no licence, so it is never committed (docs/adr/0072).
/claude/skills/figma-design-to-code/
__pycache__/

# batch-spec.sh run logs and metadata, and the local ticket list (a private backlog)
/tools/run/spec-batch.txt
/.spec-batch/

# Codex writes TUI approvals here; machine-local by design (docs/adr/0062).
/codex/rules/default.rules
