# Claude Code auto-regenerates these inside the symlinked skills/ directory
# whenever a bundled/example skill (docx, pdf, pptx, xlsx, skill-creator,
# morning, session-start-hook, ...) gets listed as available in a session.
# Not deliberately-curated repo content — see dotfiles/README.md's "Deliberately not
# synced" list for the same category of auto-regenerated files.
/dotfiles/claude/skills/synced/
/dotfiles/claude/skills/session-start-hook/
# The Claude app moves removed skills here; they are licensed copies, not repo content.
/dotfiles/claude/skills/.trash/
# Fetched at a pinned commit by dotfiles/tools/setup/fetch-figma-skill.sh;
# the upstream repo has no licence, so it is never committed (dotfiles/docs/adr/0072).
/dotfiles/claude/skills/figma-design-to-code/
__pycache__/

# batch-spec.sh run logs and metadata
/.spec-batch/

# Codex writes TUI approvals here; machine-local by design (dotfiles/docs/adr/0062).
/dotfiles/codex/rules/default.rules
